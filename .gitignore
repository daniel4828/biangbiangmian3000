# Database
data/

# YouTube cookies for yt-dlp (#491) — already covered by data/ above, but
# listed explicitly so they can never be committed even if data/ is unignored
data/yt_cookies.txt

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
# 不带斜杠的这两条是必需的：带斜杠的模式只匹配目录，匹配不到同名的软链接。
# #960 就是这么把一个指向开发机的 .venv 软链接提交了进来——服务器 pull 之后
# 真的虚拟环境被换成死链接，deploy.sh 在 pip 那步挂掉，从此不再重启服务。
.venv
venv
.env

# macOS
.DS_Store

# Editor
.idea/
.vscode/

# Claude Code
.claude/worktrees/
.claude/settings.local.json
create_issues.sh

# Personal / non-code material that lives in the working directory but must
# never reach this PUBLIC repo (a `git add -A` swept these in once — #670):
# copyrighted books, drafts, scratch notes.
thinking fast and slow/
speech/
plans/
*.pdf
